# StockPulse AI — environment variables (placeholders only; never real values).
# Derived from docs/30_ENVIRONMENT_VARIABLES.md. Sections 4 (JWT/Auth) are REMOVED —
# single-user build has no auth layer (see CHANGELOG 0.2.0).

# --- 1. Application ---
APP_ENV=local
APP_NAME=stockpulse-ai
LOG_LEVEL=INFO
API_VERSION=v1
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_SECONDS=30

# --- 2. Database ---
# Local dev default: SQLite. Postgres switch (see README):
# DATABASE_URL=postgresql+psycopg://<user>:<change-me>@<host>:5432/stockpulse
DATABASE_URL=sqlite:///./stockpulse.db
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_READ_REPLICA_URL=

# --- 3. Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=0
REDIS_BROKER_DB=1
CELERY_RESULT_TTL_SECONDS=86400

# --- 5. Object storage (S3-compatible; placeholders) ---
STORAGE_ENDPOINT=<change-me>
STORAGE_REGION=auto
STORAGE_BUCKET_ASSETS=stockpulse-assets
STORAGE_BUCKET_UPLOADS=stockpulse-uploads
STORAGE_ACCESS_KEY=<change-me>
STORAGE_SECRET_KEY=<change-me>
STORAGE_SIGNED_URL_TTL_MINUTES=15
UPLOAD_MAX_MB=50
UPLOAD_RETENTION_DAYS=30

# --- 6. AI providers (placeholders; injected at runtime, never committed) ---
LLM_PRIMARY_API_KEY=<change-me>
LLM_PRIMARY_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
# STOCKPULSE_LLM_PROVIDER=ollama — run the LLM locally via Ollama (no external calls; private data stays local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
EMBED_API_KEY=<change-me>
EMBED_MODEL=
AI_MONTHLY_TOKEN_BUDGET=0

# --- 7. Trend sources (per-source N pattern; see docs/15 §2 and SEED_PLAN.md) ---
SOURCE_1_NAME=adobe-stock-public-trends
SOURCE_1_ENABLED=true
SOURCE_1_RATE_LIMIT_PER_MIN=6
SOURCE_1_CACHE_TTL_HOURS=168
TREND_AGGREGATION_WINDOW_HOURS=168

# --- 8. Observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=${APP_ENV}
METRICS_ENABLED=true
TRACING_ENABLED=false

# --- 9. Feature flags (auth/signup flags removed — single-user) ---
FEATURE_TREND_AGENT=true
FEATURE_INSIGHT_AGENT=true
FEATURE_OPPORTUNITY_AGENT=true
FEATURE_CONCEPT_AGENT=true
FEATURE_PROMPT_AGENT=true
FEATURE_COMPLIANCE_AGENT=true
FEATURE_AUTO_REFRESH=true
FEATURE_EXPERIMENTAL_MODELS=false

# --- 10. Scheduler ---
STOCKPULSE_SCHEDULER_ENABLED=true
SCHEDULER_ENABLED=true
SCHEDULER_DAILY_PIPELINE=true
SCHEDULER_PIPELINE_CRON=0 2 * * *
SCHEDULER_TREND_AGGREGATION=true
SCHEDULER_MISSED_RUN_GRACE_MINUTES=30

# --- 11. Phase 2 — real-data layer (placeholders only; never real values) ---
STOCKPULSE_DEV_MODE=false
DEV_MODE=false
RSS_FEEDS=
OPENAI_API_KEY=            # optional: enables ScrapeGraphAI LLM tier (SmartScraperGraph)
SCRAPEGRAPHAI_TELEMETRY_ENABLED=false
GROQ_API_KEY=              # optional: Agent-Reach transcription
# Huginn (self-hosted event automation; requires a user-hosted Huginn instance)
HUGINN_BASE_URL=
HUGINN_API_KEY=<change-me>
TWITTER_AUTH_TOKEN=        # optional: X channel (from Cookie-Editor export)
TWITTER_CT0=               # optional: X channel
GITHUB_TOKEN=              # optional: raises GitHub API rate limit
ADOBE_CONTRIBUTOR_SESSION= # set via UI/API only, never commit

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
