# StockPulse AI — backend .env example. Copy to .env and fill in.
# See / .env.example at repo root for the full variable reference (docs: 30_ENVIRONMENT_VARIABLES).
APP_ENV=local
APP_NAME=stockpulse-ai
LOG_LEVEL=INFO
API_VERSION=v1
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_SECONDS=30
# Local dev default: SQLite. Postgres: postgresql+psycopg://<user>:<change-me>@<host>:5432/stockpulse
DATABASE_URL=sqlite:///./stockpulse.db
REDIS_URL=redis://localhost:6379/0
# Secrets below are placeholders — never commit real values.
LLM_PRIMARY_API_KEY=<change-me>
EMBED_API_KEY=<change-me>
STORAGE_ENDPOINT=<change-me>
STORAGE_BUCKET_ASSETS=stockpulse-assets
STORAGE_BUCKET_UPLOADS=stockpulse-uploads
STORAGE_ACCESS_KEY=<change-me>
STORAGE_SECRET_KEY=<change-me>
